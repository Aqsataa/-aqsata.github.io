              <div class="form-group"><label class="form-label">Judul Tahap</label><input type="text" id="wrkTitle" class="form-control" required></div>
              <div class="form-group"><label class="form-label">Ikon</label><select id="wrkIconKey" class="form-control"><option value="search">Search</option><option value="bulb">Idea</option><option value="pen">Design</option><option value="code">Execute</option><option value="rocket">Deliver</option></select></div>
            </div>
            <div class="form-group"><label class="form-label">Deskripsi</label><textarea id="wrkDescription" class="form-control" required></textarea></div>
            <div style="display:flex;gap:10px;">
              <button type="submit" id="saveProcessBtn" class="btn btn-primary">Simpan Tahapan</button>
              <button type="button" id="cancelProcessEditBtn" class="btn btn-secondary" style="display:none;">Batal Edit</button>
            </div>
          </form>
          <div class="admin-panel-card">
            <h3 style="font-size:16px;font-weight:800;margin-bottom:14px;">Daftar Tahapan Work Process</h3>
            <table class="admin-list-table">
              <thead><tr><th>No</th><th>Tahapan &amp; Deskripsi</th><th>Ikon</th><th>Aksi</th></tr></thead>
              <tbody id="adminProcessTableBody"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL GANTI PIN -->
  <div id="changePinModal" class="modal-backdrop">
    <div class="modal-box" style="max-width:420px;padding:28px;">
      <button type="button" class="modal-close-btn" id="closeChangePinBtn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <h3 style="font-size:18px;font-weight:800;margin-bottom:8px;">Ganti PIN Admin</h3>
      <p style="font-size:12.5px;color:var(--text-muted);margin-bottom:18px;">PIN baru minimal 6 karakter dan disimpan terenkripsi di server.</p>
      <form id="changePinForm">
        <div class="form-group"><label class="form-label">PIN Lama</label><input type="password" id="oldPinInput" class="form-control" required></div>
        <div class="form-group"><label class="form-label">PIN Baru</label><input type="password" id="newPinInput" class="form-control" minlength="6" required></div>
        <div class="form-group"><label class="form-label">Konfirmasi PIN Baru</label><input type="password" id="confirmNewPinInput" class="form-control" minlength="6" required></div>
        <button type="submit" id="submitChangePinBtn" class="btn btn-primary" style="width:100%;">Simpan PIN Baru</button>
      </form>
    </div>
  </div>

  <script>
    (function() {
      var GAS_API_URL = 'https://script.google.com/macros/s/AKfycbyJMpx72G4KwFBv1cgRzNvmc6ejqootv_1m69Zh1fI3tK2Zk3Jm_RRdkmG1hHFiBCI/exec';

      var SESSION_KEY = 'mka_portfolio_admin_token';
      var CACHE_KEY = 'mka_portfolio_data_cache_v1';
      var DEFAULT_PROFILE_ID = '1b32iBCb1LCPiOe6TDL8np_eXn44XxVGC';

      var DEFAULT_SEED_DATA = {
        profile: {
          FullName: 'MUHAMMAD KAISAR AQSATA NUGROHO',
          HeadlineRole: 'DIGITAL MARKETING | GRAPHIC DESIGN | UI/UX | CONTENT CREATOR',
          HeroShortBio: 'Fresh graduate Manajemen Pemasaran UPN "Veteran" Jawa Timur (GPA 3.59/4.00) dengan pengalaman praktis dalam Digital Marketing, Social Media Management, Branding UMKM, dan Content Creation berbasis data.',
          AvailabilityText: 'AVAILABLE FOR FREELANCE',
          ProfileImageId: DEFAULT_PROFILE_ID,
          Metric1Value: '3+',
          Metric1Label: 'YEARS EXPERIENCE',
          Metric2Value: '50+',
          Metric2Label: 'VISUAL & CAMPAIGN WORKS',
          Metric3Value: '10+',
          Metric3Label: 'BRANDS & CLIENTS',
          AboutMeText: 'Fresh graduate Manajemen Pemasaran di Universitas Pembangunan Nasional "Veteran" Jawa Timur (GPA 3.59/4.00) dengan pengalaman praktis di bidang Digital Marketing, Social Media Management, dan Content Creation.\n\nMemiliki keahlian dalam merancang strategi konten visual yang meningkatkan engagement, branding UMKM, pengelolaan operasional e-commerce (TikTok Shop & Shopee), serta pemasaran digital berbasis data.',
          QuoteText: 'Good marketing and visual design are not just about how they look, but how they connect with people and drive measurable growth.',
          QuoteAuthor: 'Kaisar Aqsata',
          Email: 'kaisaraqsa@gmail.com',
          WhatsApp: '083130634789',
          Instagram: '@aqsasu_',
          LinkedIn: 'https://www.linkedin.com/in/muhammad-kaisar-aqsata-nugroho-6b0321281/',
          Location: 'Sidoarjo, Jawa Timur, 61258'
        },
        projects: [
          {
            ProjectId: 'PRJ-202611-001',
            OrderNo: '01',
            Title: 'PORTFOLIO WORKS & DESIGN ARCHIVE',
            Category: 'PORTFOLIO',
            Description: 'Kumpulan lengkap karya desain grafis, UI/UX, branding UMKM, dan strategi kampanye digital di Google Drive.',
            ProjectUrl: 'https://drive.google.com/drive/folders/127D_fjARVJX-RNdS2IysAwqgyo_M1qu3?usp=drive_link'
          },
          {
            ProjectId: 'PRJ-202611-002',
            OrderNo: '02',
            Title: 'CURRICULUM VITAE (CV)',
            Category: 'CV',
            Description: 'Dokumen resmi riwayat pendidikan, pengalaman kerja, sertifikasi, dan kompetensi profesional.',
            ProjectUrl: 'https://drive.google.com/file/d/1H8PIabOrc_J10hx2cLm5NWqYfJezo2nF/view?usp=sharing'
          }
        ],
        experiences: [],
        education: [],
        skills: [],
        workProcess: []
      };

      var appState = {
        data: null,
        adminToken: sessionStorage.getItem(SESSION_KEY) || '',
        profileImageBase64: '',
        profileImageMime: '',
        removeProfileImage: false,
        confirmCallback: null
      };

      function isApiConfigured() {
        return GAS_API_URL && GAS_API_URL.indexOf('https://script.google.com/') === 0;
      }

      function isAdminUrlRequested() {
        var params = new URLSearchParams(window.location.search);
        return params.get('page') === 'admin' || window.location.hash === '#admin';
      }

      function escapeHtml(str) {
        if (str === null || str === undefined) return '';
        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      }

      function extractDriveFileId(input) {
        if (!input) return '';
        var str = String(input).trim();
        var matchD = str.match(/\/d\/([a-zA-Z0-9_-]{15,})/);
        if (matchD && matchD[1]) return matchD[1];
        var matchId = str.match(/[?&]id=([a-zA-Z0-9_-]{15,})/);
        if (matchId && matchId[1]) return matchId[1];
        return str;
      }

      function buildDriveImageUrl(fileIdOrUrl) {
        var cleanId = extractDriveFileId(fileIdOrUrl);
        if (!cleanId) return '';
        if (cleanId.indexOf('http://') === 0 || cleanId.indexOf('https://') === 0) return cleanId;
        return 'https://lh3.googleusercontent.com/d/' + encodeURIComponent(cleanId);
      }

      function formatWaNumberIntl(rawPhone) {
        var digits = String(rawPhone || '').replace(/[^0-9]/g, '');
        if (!digits) return '';
        if (digits.indexOf('0') === 0) return '62' + digits.substring(1);
        return digits;
      }

      function cleanUrlString(rawUrl) {
        var s = String(rawUrl || '').trim();
        var mdMatch = s.match(/\((https?:\/\/[^\s)]+)\)/);
        if (mdMatch && mdMatch[1]) return mdMatch[1];
        return s.replace(/^\[|\]$/g, '');
      }

      function showToast(message, type) {
        var container = document.getElementById('toastContainer');
        var item = document.createElement('div');
        item.className = 'toast-item ' + (type || 'info');
        item.textContent = message;
        container.appendChild(item);
        setTimeout(function() { if (item.parentNode) item.parentNode.removeChild(item); }, 3800);
      }

      function openConfirmDialog(message, onConfirm) {
        document.getElementById('confirmModalMessage').textContent = message;
        appState.confirmCallback = onConfirm;
        document.getElementById('confirmModal').classList.add('open');
      }

      function closeConfirmDialog() {
        document.getElementById('confirmModal').classList.remove('open');
        appState.confirmCallback = null;
      }

      function saveCacheData(data) {
        try {
          localStorage.setItem(CACHE_KEY, JSON.stringify(data));
        } catch (e) {}
      }

      function loadCacheData() {
        try {
          var raw = localStorage.getItem(CACHE_KEY);
          return raw ? JSON.parse(raw) : null;
        } catch (e) {
          return null;
        }
      }

      function callGasApi(action, bodyObj, onSuccess, onFailure) {
        if (!isApiConfigured()) {
          if (onFailure) onFailure(new Error('GAS_API_URL belum diisi di index.html'));
          return;
        }

        if (action === 'getPublicPortfolioData') {
          fetch(GAS_API_URL + '?action=getPublicPortfolioData&t=' + Date.now(), {
            method: 'GET',
            redirect: 'follow'
          })
          .then(function(res) { return res.json(); })
          .then(function(json) { if (onSuccess) onSuccess(json); })
          .catch(function(err) {
            if (onFailure) onFailure(err);
          });
          return;
        }

        var reqBody = Object.assign({ action: action }, bodyObj || {});
        fetch(GAS_API_URL, {
          method: 'POST',
          redirect: 'follow',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(reqBody)
        })
        .then(function(res) { return res.json(); })
        .then(function(json) { if (onSuccess) onSuccess(json); })
        .catch(function(err) {
          showToast('Koneksi ke server Google gagal: ' + (err && err.message ? err.message : 'Network Error'), 'error');
          if (onFailure) onFailure(err);
        });
      }

      function compressImageFile(file, maxWidth, callback) {
        if (!file) { callback('', ''); return; }
        var reader = new FileReader();
        reader.onload = function(e) {
          var img = new Image();
          img.onload = function() {
            var canvas = document.createElement('canvas');
            var w = img.width, h = img.height;
            if (w > maxWidth) { h = Math.round((h * maxWidth) / w); w = maxWidth; }
            canvas.width = w; canvas.height = h;
            canvas.getContext('2d').drawImage(img, 0, 0, w, h);
            var outMime = (file.type === 'image/png') ? 'image/png' : 'image/jpeg';
            callback(canvas.toDataURL(outMime, 0.86).split(',')[1], outMime);
          };
          img.src = e.target.result;
        };
        reader.readAsDataURL(file);
      }

      function getProcessSvgIcon(key) {
        if (key === 'search') return '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>';
        if (key === 'bulb') return '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>';
        if (key === 'pen') return '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/></svg>';
        if (key === 'code') return '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>';
        return '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>';
      }

      /* PUBLIC PORTFOLIO RENDER */
      function renderPublicPortfolio(data) {
        if (!data) return;
        appState.data = data;
        var p = data.profile || {};

        var roleParts = String(p.HeadlineRole || 'DIGITAL MARKETING | CREATIVE DESIGN').split('|');
        document.getElementById('navRolePrimary').textContent = (roleParts[0] || 'DIGITAL MARKETING').trim();
        document.getElementById('navRoleSecondary').textContent = (roleParts[1] || 'CREATIVE & UI/UX').trim();
        document.getElementById('navAvailability').textContent = p.AvailabilityText || 'AVAILABLE FOR FREELANCE';

        document.getElementById('heroFullName').textContent = p.FullName || 'MUHAMMAD KAISAR AQSATA NUGROHO';
        document.getElementById('heroHeadline').textContent = p.HeadlineRole || '';
        document.getElementById('heroShortBio').textContent = p.HeroShortBio || '';
        document.getElementById('heroLocationBadge').textContent = (p.Location || 'SIDOARJO, INDONESIA') + ' • ' + (p.AvailabilityText || 'AVAILABLE');

        document.getElementById('metric1Val').textContent = p.Metric1Value || '3+';
        document.getElementById('metric1Lbl').innerHTML = escapeHtml(p.Metric1Label || 'YEARS EXPERIENCE').replace(' ', '<br>');
        document.getElementById('metric2Val').textContent = p.Metric2Value || '50+';
        document.getElementById('metric2Lbl').innerHTML = escapeHtml(p.Metric2Label || 'PROJECTS COMPLETED').replace(' ', '<br>');
        document.getElementById('metric3Val').textContent = p.Metric3Value || '10+';
        document.getElementById('metric3Lbl').innerHTML = escapeHtml(p.Metric3Label || 'HAPPY CLIENTS').replace(' ', '<br>');

        var portraitContainer = document.getElementById('heroPortraitContainer');
        var activeProfileImgId = extractDriveFileId(p.ProfileImageId) || DEFAULT_PROFILE_ID;
        portraitContainer.innerHTML = '<img src="' + buildDriveImageUrl(activeProfileImgId) + '" alt="' + escapeHtml(p.FullName || 'Profile') + '" class="hero-portrait-img">';

        document.getElementById('aboutMeText').textContent = p.AboutMeText || '';
        document.getElementById('aboutLocation').textContent = p.Location || 'Sidoarjo, Jawa Timur';
        document.getElementById('quoteText').textContent = p.QuoteText || '';
        document.getElementById('quoteAuthor').textContent = p.QuoteAuthor || 'Kaisar Aqsata';

        renderDriveLinkButtons(data.projects || []);

        var expHtml = '';
        (data.experiences || []).forEach(function(exp) {
          expHtml +=
            '<div class="exp-item">' +
              '<div class="exp-top"><div class="exp-role">' + escapeHtml(exp.Role) + '</div><div class="exp-period">' + escapeHtml(exp.Period) + '</div></div>' +
              '<div class="exp-company-row"><span>' + escapeHtml(exp.Company) + '</span>' + (exp.EmploymentType ? '<span class="exp-type-badge">' + escapeHtml(exp.EmploymentType) + '</span>' : '') + '</div>' +
              '<div class="exp-desc">' + escapeHtml(exp.Description) + '</div>' +
            '</div>';
        });
        document.getElementById('experienceList').innerHTML = expHtml || '<p style="color:var(--text-muted);">Belum ada data pengalaman.</p>';

        var eduHtml = '';
        (data.education || []).forEach(function(edu) {
          eduHtml +=
            '<div class="edu-item">' +
              '<div class="edu-row-top"><div class="edu-title">' + escapeHtml(edu.Title) + '</div><div class="edu-period">' + escapeHtml(edu.Period) + '</div></div>' +
              '<div class="edu-inst">' + escapeHtml(edu.Institution) + '</div>' +
              (edu.Details ? '<div class="edu-details">' + escapeHtml(edu.Details) + '</div>' : '') +
            '</div>';
        });
        document.getElementById('educationList').innerHTML = eduHtml;

        var skillHtml = '';
        (data.skills || []).forEach(function(sk) { skillHtml += '<span class="skill-chip">' + escapeHtml(sk.SkillName) + '</span>'; });
        document.getElementById('skillsList').innerHTML = skillHtml;

        var procHtml = '';
        (data.workProcess || []).forEach(function(wp) {
          procHtml +=
            '<div class="process-item">' +
              '<div class="process-num">' + escapeHtml(wp.StepNumber) + '</div>' +
              '<div class="process-icon-box">' + getProcessSvgIcon(wp.IconKey) + '</div>' +
              '<div><div class="process-title">' + escapeHtml(wp.StepTitle) + '</div><div class="process-desc">' + escapeHtml(wp.Description) + '</div></div>' +
            '</div>';
        });
        document.getElementById('workProcessList').innerHTML = procHtml;

        var rawWa = String(p.WhatsApp || '').trim();
        if (!rawWa || rawWa.indexOf('#ERROR') !== -1) rawWa = '083130634789';
        var intlWa = formatWaNumberIntl(rawWa);
        var waLink = intlWa ? ('https://wa.me/' + intlWa) : 'https://wa.me/6283130634789';

        document.getElementById('primaryWhatsappCta').href = waLink;
        document.getElementById('footerAvailabilityBtn').textContent = p.AvailabilityText || 'AVAILABLE FOR FREELANCE';
        document.getElementById('footerOwnerName').textContent = p.FullName || 'Muhammad Kaisar Aqsata Nugroho';

        var emailAddr = String(p.Email || 'kaisaraqsa@gmail.com').trim();
        var igRaw = String(p.Instagram || '@aqsasu_').trim();
        if (igRaw === '@kaisaraqsa') igRaw = '@aqsasu_';
        var igHref = igRaw.indexOf('http') === 0 ? igRaw : ('https://www.instagram.com/' + igRaw.replace(/^@/, '') + '/');

        var liHref = cleanUrlString(p.LinkedIn);
        if (!liHref || liHref.indexOf('linkedin.com') === -1) {
          liHref = 'https://www.linkedin.com/in/muhammad-kaisar-aqsata-nugroho-6b0321281/';
        }

        var contactHtml =
          '<a href="mailto:' + escapeHtml(emailAddr) + '?subject=' + encodeURIComponent('Kolaborasi / Tawaran Kerja — Portfolio') + '" target="_top" class="contact-row">' +
            '<div class="contact-icon-box"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></div>' +
            '<div><div class="contact-row-label">Email (Kirim Pesan)</div><div class="contact-row-val">' + escapeHtml(emailAddr) + '</div></div>' +
          '</a>' +
          '<a href="' + escapeHtml(waLink) + '" target="_blank" rel="noopener" class="contact-row">' +
            '<div class="contact-icon-box"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></div>' +
            '<div><div class="contact-row-label">WhatsApp</div><div class="contact-row-val">' + escapeHtml(rawWa) + '</div></div>' +
          '</a>' +
          '<a href="' + escapeHtml(igHref) + '" target="_blank" rel="noopener" class="contact-row">' +
            '<div class="contact-icon-box"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg></div>' +
            '<div><div class="contact-row-label">Instagram</div><div class="contact-row-val">' + escapeHtml(igRaw) + '</div></div>' +
          '</a>' +
          '<a href="' + escapeHtml(liHref) + '" target="_blank" rel="noopener" class="contact-row">' +
            '<div class="contact-icon-box"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></div>' +
            '<div><div class="contact-row-label">LinkedIn</div><div class="contact-row-val">Muhammad Kaisar Aqsata N.</div></div>' +
          '</a>';

        document.getElementById('contactCardsList').innerHTML = contactHtml;
      }

      /* RENDER 2 TOMBOL LINK GOOGLE DRIVE (PORTFOLIO & CURRICULUM VITAE) */
      function renderDriveLinkButtons(projects) {
        var grid = document.getElementById('projectsGrid');
        var list = (projects && projects.length > 0 && projects[0].ProjectUrl) ? projects : DEFAULT_SEED_DATA.projects;

        var html = '';
        list.forEach(function(item, idx) {
          var url = cleanUrlString(item.ProjectUrl) || '#';
          var isCv = String(item.Category || '').toUpperCase() === 'CV' || String(item.Title || '').toUpperCase().indexOf('CURRICULUM') !== -1 || String(item.Title || '').toUpperCase().indexOf('CV') !== -1;

          var iconSvg = isCv
            ? '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>'
            : '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>';

          var ctaText = isCv ? 'Buka Curriculum Vitae (Google Drive)' : 'Buka Folder Portfolio (Google Drive)';
          var displayNum = item.OrderNo || ('0' + (idx + 1));

          html +=
            '<a href="' + escapeHtml(url) + '" target="_blank" rel="noopener" class="drive-link-btn-card">' +
              '<div>' +
                '<div class="drive-link-top">' +
                  '<div class="drive-link-icon-badge">' + iconSvg + '</div>' +
                  '<div class="drive-link-num">' + escapeHtml(displayNum) + '</div>' +
                '</div>' +
                '<div style="margin-top:20px;">' +
                  '<h3 class="drive-link-title">' + escapeHtml(item.Title) + '</h3>' +
                  '<p class="drive-link-desc">' + escapeHtml(item.Description || '') + '</p>' +
                '</div>' +
              '</div>' +
              '<div class="drive-link-cta-bar">' +
                '<span>' + ctaText + '</span>' +
                '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>' +
              '</div>' +
            '</a>';
        });

        grid.innerHTML = html;
      }

      /* ADMIN FORMS POPULATE */
      function populateAdminForms(data) {
        if (!data) return;
        var p = data.profile || {};
        document.getElementById('cfgFullName').value = p.FullName || '';
        document.getElementById('cfgHeadlineRole').value = p.HeadlineRole || '';
        document.getElementById('cfgAvailability').value = p.AvailabilityText || '';
        document.getElementById('cfgLocation').value = p.Location || '';
        document.getElementById('cfgHeroShortBio').value = p.HeroShortBio || '';
        document.getElementById('cfgM1Val').value = p.Metric1Value || '';
        document.getElementById('cfgM1Lbl').value = p.Metric1Label || '';
        document.getElementById('cfgM2Val').value = p.Metric2Value || '';
        document.getElementById('cfgM2Lbl').value = p.Metric2Label || '';
        document.getElementById('cfgM3Val').value = p.Metric3Value || '';
        document.getElementById('cfgM3Lbl').value = p.Metric3Label || '';
        document.getElementById('cfgAboutMeText').value = p.AboutMeText || '';
        document.getElementById('cfgQuoteText').value = p.QuoteText || '';
        document.getElementById('cfgQuoteAuthor').value = p.QuoteAuthor || '';
        document.getElementById('cfgEmail').value = p.Email || '';
        document.getElementById('cfgWhatsApp').value = (p.WhatsApp && p.WhatsApp.indexOf('#ERROR') === -1) ? p.WhatsApp : '083130634789';
        document.getElementById('cfgInstagram').value = p.Instagram || '@aqsasu_';
        document.getElementById('cfgLinkedIn').value = cleanUrlString(p.LinkedIn) || 'https://www.linkedin.com/in/muhammad-kaisar-aqsata-nugroho-6b0321281/';

        var activeImgId = extractDriveFileId(p.ProfileImageId) || DEFAULT_PROFILE_ID;
        document.getElementById('cfgProfileDriveLink').value = activeImgId;
        var prev = document.getElementById('cfgProfilePreview');
        prev.innerHTML = activeImgId ? '<img src="' + buildDriveImageUrl(activeImgId) + '" alt="Profil">' : 'Belum ada foto';
        appState.profileImageBase64 = '';
        appState.removeProfileImage = false;
        document.getElementById('cfgProfilePhotoInput').value = '';

        var prjRows = '';
        (data.projects || []).forEach(function(item) {
          prjRows += '<tr><td style="font-weight:800;color:var(--crimson);">' + escapeHtml(item.OrderNo) + '</td><td><div style="font-weight:700;">' + escapeHtml(item.Title) + '</div><div style="font-size:11px;color:var(--text-muted);word-break:break-all;">' + escapeHtml(item.ProjectUrl || '') + '</div></td><td>' + escapeHtml(item.Category || 'PORTFOLIO') + '</td><td style="white-space:nowrap;"><button type="button" class="btn btn-secondary btn-sm" data-edit-project="' + escapeHtml(item.ProjectId) + '">Edit</button> <button type="button" class="btn btn-danger btn-sm" data-del-project="' + escapeHtml(item.ProjectId) + '">Hapus</button></td></tr>';
        });
        document.getElementById('adminProjectsTableBody').innerHTML = prjRows || '<tr><td colspan="4" style="color:var(--text-muted);">Belum ada tombol link.</td></tr>';

        var expRows = '';
        (data.experiences || []).forEach(function(item) {
          expRows += '<tr><td><div style="font-weight:700;">' + escapeHtml(item.Company) + '</div><div style="font-size:12px;color:var(--crimson);">' + escapeHtml(item.Role) + '</div></td><td>' + escapeHtml(item.Period) + '</td><td>' + escapeHtml(item.EmploymentType) + '</td><td style="white-space:nowrap;"><button type="button" class="btn btn-secondary btn-sm" data-edit-exp="' + escapeHtml(item.ExpId) + '">Edit</button> <button type="button" class="btn btn-danger btn-sm" data-del-exp="' + escapeHtml(item.ExpId) + '">Hapus</button></td></tr>';
        });
        document.getElementById('adminExpTableBody').innerHTML = expRows || '<tr><td colspan="4">Belum ada pengalaman.</td></tr>';

        var eduRows = '';
        (data.education || []).forEach(function(item) {
          eduRows += '<tr><td><div style="font-weight:700;">' + escapeHtml(item.Title) + '</div><div style="font-size:12px;color:var(--text-muted);">' + escapeHtml(item.Institution) + '</div></td><td>' + escapeHtml(item.Period) + '</td><td>' + escapeHtml(item.Category) + '</td><td style="white-space:nowrap;"><button type="button" class="btn btn-secondary btn-sm" data-edit-edu="' + escapeHtml(item.EduId) + '">Edit</button> <button type="button" class="btn btn-danger btn-sm" data-del-edu="' + escapeHtml(item.EduId) + '">Hapus</button></td></tr>';
        });
        document.getElementById('adminEduTableBody').innerHTML = eduRows || '<tr><td colspan="4">Belum ada pendidikan.</td></tr>';

        var skBadges = '';
        (data.skills || []).forEach(function(item) {
          skBadges += '<div style="display:inline-flex;align-items:center;gap:8px;background:#1A1A20;border:1px solid var(--border-strong);padding:7px 12px;border-radius:6px;font-size:12px;"><span>' + escapeHtml(item.SkillName) + '</span><button type="button" data-del-skill="' + escapeHtml(item.SkillId) + '" style="background:none;border:none;color:#FF5C66;cursor:pointer;font-weight:800;font-size:14px;">&times;</button></div>';
        });
        document.getElementById('adminSkillsList').innerHTML = skBadges;

        var procRows = '';
        (data.workProcess || []).forEach(function(item) {
          procRows += '<tr><td style="font-weight:800;color:var(--crimson);">' + escapeHtml(item.StepNumber) + '</td><td><div style="font-weight:700;">' + escapeHtml(item.StepTitle) + '</div><div style="font-size:12px;color:var(--text-muted);">' + escapeHtml(item.Description) + '</div></td><td>' + escapeHtml(item.IconKey) + '</td><td style="white-space:nowrap;"><button type="button" class="btn btn-secondary btn-sm" data-edit-proc="' + escapeHtml(item.StepId) + '">Edit</button> <button type="button" class="btn btn-danger btn-sm" data-del-proc="' + escapeHtml(item.StepId) + '">Hapus</button></td></tr>';
        });
        document.getElementById('adminProcessTableBody').innerHTML = procRows;
      }

      function switchToAdminView() {
        document.getElementById('publicView').classList.add('hidden');
        document.getElementById('adminView').classList.add('active');
        if (!isApiConfigured()) {
          showToast('GAS_API_URL di index.html belum diisi.', 'error');
        }
        if (appState.adminToken) {
          callGasApi('validateAdminSession', { token: appState.adminToken }, function(res) {
            if (res && res.valid) {
              document.getElementById('adminLoginScreen').style.display = 'none';
              document.getElementById('adminDashboardScreen').style.display = 'block';
              populateAdminForms(appState.data);
            } else {
              appState.adminToken = '';
              sessionStorage.removeItem(SESSION_KEY);
              document.getElementById('adminLoginScreen').style.display = 'flex';
              document.getElementById('adminDashboardScreen').style.display = 'none';
            }
          });
        } else {
          document.getElementById('adminLoginScreen').style.display = 'flex';
          document.getElementById('adminDashboardScreen').style.display = 'none';
        }
      }

      function switchToPublicView() {
        document.getElementById('adminView').classList.remove('active');
        document.getElementById('publicView').classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      function handleBackendResponse(res, successMsg, resetFn) {
        if (!res || !res.success) {
          showToast((res && res.message) ? res.message : 'Gagal menyimpan data.', 'error');
          if (res && res.unauthorized) {
            appState.adminToken = '';
            sessionStorage.removeItem(SESSION_KEY);
            switchToAdminView();
          }
          return;
        }
        showToast(successMsg, 'success');
        if (res.data) {
          saveCacheData(res.data);
          renderPublicPortfolio(res.data);
          populateAdminForms(res.data);
        }
        if (resetFn) resetFn();
      }

      function resetProjectForm() {
        document.getElementById('prjIdInput').value = '';
        document.getElementById('prjOrderNo').value = '';
        document.getElementById('prjTitle').value = '';
        document.getElementById('prjCategory').value = 'PORTFOLIO';
        document.getElementById('prjDescription').value = '';
        document.getElementById('prjUrl').value = '';
        document.getElementById('projectFormHeading').textContent = 'Tambah / Edit Tombol Link Google Drive';
        document.getElementById('cancelProjectEditBtn').style.display = 'none';
      }

      function resetExpForm() {
        ['expIdInput', 'expCompany', 'expRole', 'expType', 'expPeriod', 'expDescription'].forEach(function(id) { document.getElementById(id).value = ''; });
        document.getElementById('expFormHeading').textContent = 'Tambah Pengalaman Kerja';
        document.getElementById('cancelExpEditBtn').style.display = 'none';
      }

      function resetEduForm() {
        ['eduIdInput', 'eduTitle', 'eduInstitution', 'eduPeriod', 'eduDetails'].forEach(function(id) { document.getElementById(id).value = ''; });
        document.getElementById('eduCategory').value = 'Education';
        document.getElementById('eduFormHeading').textContent = 'Tambah Pendidikan / Sertifikasi';
        document.getElementById('cancelEduEditBtn').style.display = 'none';
      }

      function resetProcessForm() {
        ['wrkIdInput', 'wrkNumber', 'wrkTitle', 'wrkDescription'].forEach(function(id) { document.getElementById(id).value = ''; });
        document.getElementById('wrkIconKey').value = 'search';
        document.getElementById('processFormHeading').textContent = 'Kelola Tahapan Work Process';
        document.getElementById('cancelProcessEditBtn').style.display = 'none';
      }

      document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('footerYear').textContent = new Date().getFullYear();

        document.getElementById('mobileMenuBtn').addEventListener('click', function() { document.getElementById('mobileDrawer').classList.toggle('open'); });
        document.querySelectorAll('.mobile-nav-link').forEach(function(el) { el.addEventListener('click', function() { document.getElementById('mobileDrawer').classList.remove('open'); }); });

        var clickCount = 0, clickTimer = null;
        document.getElementById('secretAdminTrigger').addEventListener('click', function() {
          clickCount++; clearTimeout(clickTimer);
          if (clickCount >= 3) { clickCount = 0; switchToAdminView(); }
          else { clickTimer = setTimeout(function() { clickCount = 0; }, 900); }
        });

        document.getElementById('confirmCancelBtn').addEventListener('click', closeConfirmDialog);
        document.getElementById('confirmProceedBtn').addEventListener('click', function() { var cb = appState.confirmCallback; closeConfirmDialog(); if (cb) cb(); });

        document.getElementById('backToPublicBtn').addEventListener('click', switchToPublicView);
        document.getElementById('viewPublicSiteBtn').addEventListener('click', switchToPublicView);

        document.getElementById('adminLoginForm').addEventListener('submit', function(e) {
          e.preventDefault();
          var pin = document.getElementById('adminPinInput').value;
          var btn = document.getElementById('adminLoginSubmitBtn');
          var errBox = document.getElementById('loginErrorBox');
          errBox.style.display = 'none'; btn.disabled = true; btn.textContent = 'Memverifikasi...';
          callGasApi('verifyAdminPin', { pin: pin }, function(res) {
            btn.disabled = false; btn.textContent = 'Masuk Dashboard';
            if (res && res.success) {
              appState.adminToken = res.token; sessionStorage.setItem(SESSION_KEY, res.token);
              document.getElementById('adminPinInput').value = '';
              document.getElementById('adminLoginScreen').style.display = 'none';
              document.getElementById('adminDashboardScreen').style.display = 'block';
              populateAdminForms(appState.data);
              showToast('Login berhasil!', 'success');
            } else {
              errBox.textContent = (res && res.message) ? res.message : 'PIN salah.'; errBox.style.display = 'block';
            }
          }, function() { btn.disabled = false; btn.textContent = 'Masuk Dashboard'; });
        });

        document.getElementById('adminLogoutBtn').addEventListener('click', function() {
          var tok = appState.adminToken; appState.adminToken = ''; sessionStorage.removeItem(SESSION_KEY);
          callGasApi('logoutAdmin', { token: tok }); showToast('Logout berhasil.', 'info'); switchToPublicView();
        });

        document.getElementById('openChangePinModalBtn').addEventListener('click', function() { document.getElementById('changePinModal').classList.add('open'); });
        document.getElementById('closeChangePinBtn').addEventListener('click', function() { document.getElementById('changePinModal').classList.remove('open'); });
        document.getElementById('changePinForm').addEventListener('submit', function(e) {
          e.preventDefault();
          var oldPin = document.getElementById('oldPinInput').value, newPin = document.getElementById('newPinInput').value, confirmPin = document.getElementById('confirmNewPinInput').value;
          if (newPin !== confirmPin) { showToast('Konfirmasi PIN baru tidak cocok.', 'error'); return; }
          var btn = document.getElementById('submitChangePinBtn'); btn.disabled = true;
          callGasApi('changeAdminPin', { token: appState.adminToken, oldPin: oldPin, newPin: newPin }, function(res) {
            btn.disabled = false;
            if (res && res.success) { document.getElementById('changePinForm').reset(); document.getElementById('changePinModal').classList.remove('open'); showToast('PIN Admin diperbarui!', 'success'); }
            else { showToast((res && res.message) ? res.message : 'Gagal mengganti PIN.', 'error'); }
          }, function() { btn.disabled = false; });
        });

        document.getElementById('adminTabsNav').addEventListener('click', function(e) {
          var btn = e.target.closest('.admin-tab-btn');
          if (!btn) return;
          var targetId = btn.getAttribute('data-tab');
          document.querySelectorAll('.admin-tab-btn').forEach(function(b) { b.classList.remove('active'); });
          btn.classList.add('active');
          document.querySelectorAll('.admin-tab-content').forEach(function(sec) { sec.style.display = (sec.id === targetId) ? 'block' : 'none'; });
        });

        document.getElementById('cfgProfilePhotoInput').addEventListener('change', function(e) {
          var file = e.target.files[0]; if (!file) return;
          compressImageFile(file, 1200, function(b64, mime) {
            appState.profileImageBase64 = b64; appState.profileImageMime = mime; appState.removeProfileImage = false;
            document.getElementById('cfgProfilePreview').innerHTML = '<img src="data:' + mime + ';base64,' + b64 + '">';
          });
        });

        document.getElementById('cfgProfileDriveLink').addEventListener('input', function(e) {
          var extracted = extractDriveFileId(e.target.value);
          if (extracted) {
            appState.removeProfileImage = false;
            document.getElementById('cfgProfilePreview').innerHTML = '<img src="' + buildDriveImageUrl(extracted) + '">';
          }
        });

        document.getElementById('removeProfilePhotoBtn').addEventListener('click', function() {
          appState.profileImageBase64 = ''; appState.profileImageMime = ''; appState.removeProfileImage = true;
          document.getElementById('cfgProfilePhotoInput').value = '';
          document.getElementById('cfgProfileDriveLink').value = '';
          document.getElementById('cfgProfilePreview').textContent = 'Foto akan dihapus saat disimpan';
        });

        document.getElementById('profileAdminForm').addEventListener('submit', function(e) {
          e.preventDefault();
          var btn = document.getElementById('saveProfileBtn'); btn.disabled = true; btn.textContent = 'Menyimpan...';
          var payload = {
            FullName: document.getElementById('cfgFullName').value.trim(),
            HeadlineRole: document.getElementById('cfgHeadlineRole').value.trim(),
            AvailabilityText: document.getElementById('cfgAvailability').value.trim(),
            Location: document.getElementById('cfgLocation').value.trim(),
            HeroShortBio: document.getElementById('cfgHeroShortBio').value.trim(),
            Metric1Value: document.getElementById('cfgM1Val').value.trim(),
            Metric1Label: document.getElementById('cfgM1Lbl').value.trim(),
            Metric2Value: document.getElementById('cfgM2Val').value.trim(),
            Metric2Label: document.getElementById('cfgM2Lbl').value.trim(),
            Metric3Value: document.getElementById('cfgM3Val').value.trim(),
            Metric3Label: document.getElementById('cfgM3Lbl').value.trim(),
            AboutMeText: document.getElementById('cfgAboutMeText').value.trim(),
            QuoteText: document.getElementById('cfgQuoteText').value.trim(),
            QuoteAuthor: document.getElementById('cfgQuoteAuthor').value.trim(),
            Email: document.getElementById('cfgEmail').value.trim(),
            WhatsApp: document.getElementById('cfgWhatsApp').value.trim(),
            Instagram: document.getElementById('cfgInstagram').value.trim(),
            LinkedIn: document.getElementById('cfgLinkedIn').value.trim(),
            directImageId: extractDriveFileId(document.getElementById('cfgProfileDriveLink').value),
            imageBase64: appState.profileImageBase64,
            imageMime: appState.profileImageMime,
            removeImage: appState.removeProfileImage
          };
          callGasApi('saveProfileConfig', { token: appState.adminToken, payload: payload }, function(res) {
            btn.disabled = false; btn.textContent = 'Simpan Perubahan Profil';
            handleBackendResponse(res, 'Profil & Kontak berhasil disimpan!');
          }, function() { btn.disabled = false; btn.textContent = 'Simpan Perubahan Profil'; });
        });

        document.getElementById('projectAdminForm').addEventListener('submit', function(e) {
          e.preventDefault();
          var btn = document.getElementById('saveProjectBtn'); btn.disabled = true; btn.textContent = 'Menyimpan...';
          var payload = {
            ProjectId: document.getElementById('prjIdInput').value.trim(),
            OrderNo: document.getElementById('prjOrderNo').value.trim(),
            Title: document.getElementById('prjTitle').value.trim(),
            Category: document.getElementById('prjCategory').value,
            Description: document.getElementById('prjDescription').value.trim(),
            ProjectUrl: document.getElementById('prjUrl').value.trim()
          };
          callGasApi('saveProject', { token: appState.adminToken, payload: payload }, function(res) {
            btn.disabled = false; btn.textContent = 'Simpan Tombol Link';
            handleBackendResponse(res, 'Tombol link berhasil disimpan!', resetProjectForm);
          }, function() { btn.disabled = false; btn.textContent = 'Simpan Tombol Link'; });
        });

        document.getElementById('cancelProjectEditBtn').addEventListener('click', resetProjectForm);

        document.getElementById('adminProjectsTableBody').addEventListener('click', function(e) {
          var editBtn = e.target.closest('[data-edit-project]');
          var delBtn = e.target.closest('[data-del-project]');
          if (editBtn && appState.data) {
            var id = editBtn.getAttribute('data-edit-project');
            var found = appState.data.projects.filter(function(x) { return x.ProjectId === id; })[0];
            if (found) {
              document.getElementById('prjIdInput').value = found.ProjectId;
              document.getElementById('prjOrderNo').value = found.OrderNo;
              document.getElementById('prjTitle').value = found.Title;
              document.getElementById('prjCategory').value = found.Category || 'PORTFOLIO';
              document.getElementById('prjDescription').value = found.Description;
              document.getElementById('prjUrl').value = found.ProjectUrl || '';
              document.getElementById('projectFormHeading').textContent = 'Edit Link: ' + found.Title;
              document.getElementById('cancelProjectEditBtn').style.display = 'inline-flex';
              window.scrollTo({ top: 0, behavior: 'smooth' });
            }
          }
          if (delBtn) {
            var delId = delBtn.getAttribute('data-del-project');
            openConfirmDialog('Hapus tombol link ini?', function() {
              callGasApi('deleteProject', { token: appState.adminToken, id: delId }, function(res) { handleBackendResponse(res, 'Tombol link berhasil dihapus!', resetProjectForm); });
            });
          }
        });

        document.getElementById('expAdminForm').addEventListener('submit', function(e) {
          e.preventDefault();
          var btn = document.getElementById('saveExpBtn'); btn.disabled = true;
          var payload = {
            ExpId: document.getElementById('expIdInput').value.trim(), Company: document.getElementById('expCompany').value.trim(),
            Role: document.getElementById('expRole').value.trim(), EmploymentType: document.getElementById('expType').value.trim(),
            Period: document.getElementById('expPeriod').value.trim(), Description: document.getElementById('expDescription').value.trim()
          };
          callGasApi('saveExperience', { token: appState.adminToken, payload: payload }, function(res) { btn.disabled = false; handleBackendResponse(res, 'Pengalaman disimpan!', resetExpForm); }, function() { btn.disabled = false; });
        });
        document.getElementById('cancelExpEditBtn').addEventListener('click', resetExpForm);
        document.getElementById('adminExpTableBody').addEventListener('click', function(e) {
          var editBtn = e.target.closest('[data-edit-exp]'), delBtn = e.target.closest('[data-del-exp]');
          if (editBtn && appState.data) {
            var found = appState.data.experiences.filter(function(x) { return x.ExpId === editBtn.getAttribute('data-edit-exp'); })[0];
            if (found) {
              document.getElementById('expIdInput').value = found.ExpId; document.getElementById('expCompany').value = found.Company;
              document.getElementById('expRole').value = found.Role; document.getElementById('expType').value = found.EmploymentType;
              document.getElementById('expPeriod').value = found.Period; document.getElementById('expDescription').value = found.Description;
              document.getElementById('expFormHeading').textContent = 'Edit: ' + found.Company;
              document.getElementById('cancelExpEditBtn').style.display = 'inline-flex';
              window.scrollTo({ top: 0, behavior: 'smooth' });
            }
          }
          if (delBtn) {
            var delId = delBtn.getAttribute('data-del-exp');
            openConfirmDialog('Hapus riwayat pengalaman ini?', function() { callGasApi('deleteExperience', { token: appState.adminToken, id: delId }, function(res) { handleBackendResponse(res, 'Dihapus!', resetExpForm); }); });
          }
        });

        document.getElementById('eduAdminForm').addEventListener('submit', function(e) {
          e.preventDefault();
          var btn = document.getElementById('saveEduBtn'); btn.disabled = true;
          var payload = {
            EduId: document.getElementById('eduIdInput').value.trim(), Category: document.getElementById('eduCategory').value,
            Title: document.getElementById('eduTitle').value.trim(), Institution: document.getElementById('eduInstitution').value.trim(),
            Period: document.getElementById('eduPeriod').value.trim(), Details: document.getElementById('eduDetails').value.trim()
          };
          callGasApi('saveEducation', { token: appState.adminToken, payload: payload }, function(res) { btn.disabled = false; handleBackendResponse(res, 'Data disimpan!', resetEduForm); }, function() { btn.disabled = false; });
        });
        document.getElementById('cancelEduEditBtn').addEventListener('click', resetEduForm);
        document.getElementById('adminEduTableBody').addEventListener('click', function(e) {
          var editBtn = e.target.closest('[data-edit-edu]'), delBtn = e.target.closest('[data-del-edu]');
          if (editBtn && appState.data) {
            var found = appState.data.education.filter(function(x) { return x.EduId === editBtn.getAttribute('data-edit-edu'); })[0];
            if (found) {
              document.getElementById('eduIdInput').value = found.EduId; document.getElementById('eduCategory').value = found.Category;
              document.getElementById('eduTitle').value = found.Title; document.getElementById('eduInstitution').value = found.Institution;
              document.getElementById('eduPeriod').value = found.Period; document.getElementById('eduDetails').value = found.Details || '';
              document.getElementById('eduFormHeading').textContent = 'Edit: ' + found.Title;
              document.getElementById('cancelEduEditBtn').style.display = 'inline-flex';
              window.scrollTo({ top: 0, behavior: 'smooth' });
            }
          }
          if (delBtn) {
            var delId = delBtn.getAttribute('data-del-edu');
            openConfirmDialog('Hapus data ini?', function() { callGasApi('deleteEducation', { token: appState.adminToken, id: delId }, function(res) { handleBackendResponse(res, 'Dihapus!', resetEduForm); }); });
          }
        });

        document.getElementById('skillAdminForm').addEventListener('submit', function(e) {
          e.preventDefault();
          var btn = document.getElementById('saveSkillBtn'); btn.disabled = true;
          callGasApi('saveSkill', { token: appState.adminToken, payload: { SkillName: document.getElementById('skillNameInput').value.trim(), GroupCategory: document.getElementById('skillGroupInput').value } }, function(res) {
            btn.disabled = false; handleBackendResponse(res, 'Skill ditambahkan!', function() { document.getElementById('skillNameInput').value = ''; });
          }, function() { btn.disabled = false; });
        });
        document.getElementById('adminSkillsList').addEventListener('click', function(e) {
          var delBtn = e.target.closest('[data-del-skill]');
          if (delBtn) {
            var delId = delBtn.getAttribute('data-del-skill');
            openConfirmDialog('Hapus skill ini?', function() { callGasApi('deleteSkill', { token: appState.adminToken, id: delId }, function(res) { handleBackendResponse(res, 'Skill dihapus!'); }); });
          }
        });

        document.getElementById('processAdminForm').addEventListener('submit', function(e) {
          e.preventDefault();
          var btn = document.getElementById('saveProcessBtn'); btn.disabled = true;
          var payload = {
            StepId: document.getElementById('wrkIdInput').value.trim(), StepNumber: document.getElementById('wrkNumber').value.trim(),
            StepTitle: document.getElementById('wrkTitle').value.trim(), IconKey: document.getElementById('wrkIconKey').value,
            Description: document.getElementById('wrkDescription').value.trim()
          };
          callGasApi('saveWorkProcess', { token: appState.adminToken, payload: payload }, function(res) { btn.disabled = false; handleBackendResponse(res, 'Tahapan disimpan!', resetProcessForm); }, function() { btn.disabled = false; });
        });
        document.getElementById('cancelProcessEditBtn').addEventListener('click', resetProcessForm);
        document.getElementById('adminProcessTableBody').addEventListener('click', function(e) {
          var editBtn = e.target.closest('[data-edit-proc]'), delBtn = e.target.closest('[data-del-proc]');
          if (editBtn && appState.data) {
            var found = appState.data.workProcess.filter(function(x) { return x.StepId === editBtn.getAttribute('data-edit-proc'); })[0];
            if (found) {
              document.getElementById('wrkIdInput').value = found.StepId; document.getElementById('wrkNumber').value = found.StepNumber;
              document.getElementById('wrkTitle').value = found.StepTitle; document.getElementById('wrkIconKey').value = found.IconKey || 'search';
              document.getElementById('wrkDescription').value = found.Description;
              document.getElementById('processFormHeading').textContent = 'Edit Tahap ' + found.StepNumber;
              document.getElementById('cancelProcessEditBtn').style.display = 'inline-flex';
              window.scrollTo({ top: 0, behavior: 'smooth' });
            }
          }
          if (delBtn) {
            var delId = delBtn.getAttribute('data-del-proc');
            openConfirmDialog('Hapus tahapan ini?', function() { callGasApi('deleteWorkProcess', { token: appState.adminToken, id: delId }, function(res) { handleBackendResponse(res, 'Dihapus!', resetProcessForm); }); });
          }
        });

        var cachedData = loadCacheData();
        if (cachedData) {
          renderPublicPortfolio(cachedData);
          document.getElementById('globalLoader').classList.add('hidden');
        } else if (!isApiConfigured()) {
          renderPublicPortfolio(DEFAULT_SEED_DATA);
          document.getElementById('globalLoader').classList.add('hidden');
        }

        callGasApi('getPublicPortfolioData', null, function(res) {
          document.getElementById('globalLoader').classList.add('hidden');
          if (res && res.success && res.data) {
            saveCacheData(res.data);
            renderPublicPortfolio(res.data);
          } else if (!cachedData) {
            renderPublicPortfolio(DEFAULT_SEED_DATA);
          }
          if (isAdminUrlRequested()) { switchToAdminView(); }
        }, function() {
          document.getElementById('globalLoader').classList.add('hidden');
          if (!cachedData) { renderPublicPortfolio(DEFAULT_SEED_DATA); }
          if (isAdminUrlRequested()) { switchToAdminView(); }
        });
      });
    })();
  </script>
</body>
</html>