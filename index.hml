<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portfolio — Muhammad Kaisar Aqsata Nugroho</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Caveat:wght@600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-black: #08080A;
      --bg-surface: #111115;
      --bg-card: #16161B;
      --bg-card-hover: #1E1E25;
      --crimson: #D91E2A;
      --crimson-glow: rgba(217, 30, 42, 0.25);
      --text-white: #F8F8FA;
      --text-muted: #9E9EA8;
      --border-subtle: rgba(255, 255, 255, 0.08);
      --border-strong: rgba(255, 255, 255, 0.16);
      --font-display: 'Anton', sans-serif;
      --font-sans: 'Plus Jakarta Sans', sans-serif;
      --font-script: 'Caveat', cursive;
      --radius-md: 10px;
      --radius-lg: 14px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; background: var(--bg-black); color: var(--text-white); font-family: var(--font-sans); }
    body { background: var(--bg-black); color: var(--text-white); overflow-x: hidden; line-height: 1.6; -webkit-font-smoothing: antialiased; }
    a { color: inherit; text-decoration: none; }
    button, input, textarea, select { font-family: inherit; }

    .container { width: 100%; max-width: 1220px; margin: 0 auto; padding: 0 24px; }

    /* LOADER & TOAST */
    .global-loader {
      position: fixed; inset: 0; background: var(--bg-black);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      z-index: 9999; transition: opacity 0.35s ease, visibility 0.35s ease;
    }
    .global-loader.hidden { opacity: 0; visibility: hidden; pointer-events: none; }
    .spinner-ring {
      width: 44px; height: 44px; border: 3px solid rgba(217, 30, 42, 0.2);
      border-top-color: var(--crimson); border-radius: 50%; animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .toast-container { position: fixed; top: 20px; right: 20px; z-index: 10000; display: flex; flex-direction: column; gap: 10px; max-width: 360px; }
    .toast-item {
      background: var(--bg-card); border: 1px solid var(--border-strong); border-left: 4px solid var(--crimson);
      color: var(--text-white); padding: 13px 16px; border-radius: 8px; font-size: 13.5px; font-weight: 500;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6); animation: slideInRight 0.25s ease;
    }
    .toast-item.success { border-left-color: #10B981; }
    .toast-item.error { border-left-color: #EF4444; }
    @keyframes slideInRight { from { transform: translateX(30px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

    /* NAVBAR */
    .navbar { position: sticky; top: 0; z-index: 900; background: rgba(8, 8, 10, 0.88); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border-subtle); }
    .navbar-inner { display: flex; align-items: center; justify-content: space-between; height: 70px; }
    .nav-brand-stack { display: flex; flex-direction: column; line-height: 1.25; font-size: 11px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
    .nav-brand-stack span:first-child { color: var(--crimson); }
    .nav-links { display: flex; align-items: center; gap: 26px; }
    .nav-links a { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); transition: color 0.2s ease; }
    .nav-links a:hover { color: var(--text-white); }
    .nav-status { display: flex; align-items: center; gap: 10px; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
    .status-spark { color: var(--crimson); font-size: 15px; line-height: 1; }
    .mobile-menu-btn { display: none; background: transparent; border: 1px solid var(--border-strong); color: var(--text-white); width: 40px; height: 40px; border-radius: 8px; align-items: center; justify-content: center; cursor: pointer; }
    .mobile-drawer { display: none; background: var(--bg-surface); border-bottom: 1px solid var(--border-strong); padding: 16px 24px 24px; flex-direction: column; gap: 14px; }
    .mobile-drawer.open { display: flex; }
    .mobile-drawer a { font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 6px 0; }

    /* HERO SECTION */
    .hero-section { position: relative; padding: 36px 0 80px; overflow: hidden; border-bottom: 1px solid var(--border-subtle); }
    .hero-bg-word {
      position: absolute; top: 10px; left: 50%; transform: translateX(-50%);
      font-family: var(--font-display); font-size: clamp(92px, 21vw, 290px); line-height: 0.85;
      letter-spacing: 0.01em; text-transform: uppercase;
      background: linear-gradient(180deg, #9C141E 0%, #3D070B 78%, rgba(8, 8, 10, 0) 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      user-select: none; pointer-events: none; z-index: 1; white-space: nowrap;
    }
    .hero-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 1.05fr 1.2fr 0.75fr; gap: 28px; align-items: end; min-height: 540px; padding-top: 85px; }
    .hero-left { padding-bottom: 18px; }
    .hero-hello { font-family: var(--font-script); font-size: 32px; color: var(--text-white); margin-bottom: -4px; display: block; }
    .hero-name { font-family: var(--font-display); font-size: clamp(42px, 5.4vw, 72px); line-height: 0.96; letter-spacing: 0.01em; text-transform: uppercase; margin-bottom: 14px; }
    .hero-role { font-size: 13px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--crimson); margin-bottom: 14px; }
    .hero-bio { font-size: 13.5px; color: var(--text-muted); line-height: 1.65; margin-bottom: 22px; max-width: 400px; }
    .hero-badge-row { display: flex; align-items: center; gap: 10px; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 22px; }
    .pulse-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--crimson); box-shadow: 0 0 0 4px rgba(217, 30, 42, 0.25); }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }

    .hero-center { display: flex; justify-content: center; align-items: flex-end; position: relative; }
    .hero-portrait-frame { position: relative; width: 100%; max-width: 430px; aspect-ratio: 3 / 4; display: flex; align-items: flex-end; justify-content: center; overflow: hidden; background: transparent; }
    .hero-portrait-frame::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(8, 8, 10, 0) 68%, rgba(8, 8, 10, 0.85) 92%, #08080A 100%);
      pointer-events: none;
    }
    .hero-portrait-img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; mix-blend-mode: lighten; filter: contrast(1.06); }

    .hero-right { display: flex; flex-direction: column; justify-content: space-between; gap: 20px; padding-bottom: 18px; }
    .hero-tagline-box { display: flex; align-items: flex-start; gap: 10px; font-size: 12.5px; color: var(--text-muted); line-height: 1.5; padding-bottom: 18px; border-bottom: 1px solid var(--border-subtle); }
    .hero-metrics-stack { display: flex; flex-direction: column; gap: 18px; }
    .metric-item { display: flex; align-items: center; gap: 14px; padding: 12px 14px; background: rgba(22, 22, 27, 0.75); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); transition: transform 0.2s ease, border-color 0.2s ease; }
    .metric-item:hover { transform: translateX(4px); border-color: rgba(217, 30, 42, 0.45); }
    .metric-val { font-family: var(--font-display); font-size: 38px; line-height: 1; color: var(--crimson); min-width: 68px; }
    .metric-lbl { font-size: 10.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); line-height: 1.35; }

    /* BUTTONS */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 11px 20px; border-radius: 8px; font-size: 12.5px; font-weight: 700;
      letter-spacing: 0.05em; text-transform: uppercase; cursor: pointer; border: 1px solid transparent; transition: all 0.2s ease;
    }
    .btn:disabled { opacity: 0.55; cursor: not-allowed; }
    .btn-primary { background: var(--crimson); color: #FFFFFF; }
    .btn-primary:hover:not(:disabled) { background: #B81620; transform: translateY(-1px); box-shadow: 0 8px 20px var(--crimson-glow); }
    .btn-secondary { background: var(--bg-card); color: var(--text-white); border-color: var(--border-strong); }
    .btn-secondary:hover:not(:disabled) { background: var(--bg-card-hover); border-color: var(--text-white); }
    .btn-danger { background: rgba(239, 68, 68, 0.14); color: #FF6B74; border-color: rgba(239, 68, 68, 0.35); }
    .btn-danger:hover:not(:disabled) { background: #DC2626; color: #FFFFFF; }
    .btn-sm { padding: 7px 12px; font-size: 11px; }

    /* SELECTED PROJECT & CURRICULUM VITAE (2 GOOGLE DRIVE LINK BUTTONS) */
    .section-block { padding: 74px 0; border-bottom: 1px solid var(--border-subtle); }
    .section-header-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 34px; }
    .section-title { font-family: var(--font-display); font-size: clamp(28px, 3.6vw, 40px); letter-spacing: 0.02em; text-transform: uppercase; }
    .section-eyebrow { font-size: 11.5px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--crimson); margin-bottom: 8px; display: block; }

    .drive-links-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .drive-link-btn-card {
      display: flex; flex-direction: column; justify-content: space-between; gap: 22px;
      background: linear-gradient(145deg, #17171D 0%, #101014 100%);
      border: 1px solid var(--border-strong); border-radius: var(--radius-lg); padding: 30px 28px;
      transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
      position: relative; overflow: hidden;
    }
    .drive-link-btn-card:hover {
      transform: translateY(-4px); border-color: var(--crimson);
      background: linear-gradient(145deg, #1E181C 0%, #131318 100%);
      box-shadow: 0 18px 40px rgba(217, 30, 42, 0.18);
    }
    .drive-link-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
    .drive-link-icon-badge {
      width: 52px; height: 52px; border-radius: 12px;
      background: rgba(217, 30, 42, 0.14); border: 1px solid rgba(217, 30, 42, 0.35);
      color: var(--crimson); display: flex; align-items: center; justify-content: center; flex-shrink: 0;
      transition: all 0.25s ease;
    }
    .drive-link-btn-card:hover .drive-link-icon-badge { background: var(--crimson); color: #FFFFFF; }
    .drive-link-num { font-family: var(--font-display); font-size: 32px; line-height: 1; color: rgba(255, 255, 255, 0.16); transition: color 0.25s ease; }
    .drive-link-btn-card:hover .drive-link-num { color: var(--crimson); }
    .drive-link-title { font-size: 20px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.02em; color: var(--text-white); margin-bottom: 8px; }
    .drive-link-desc { font-size: 13.5px; color: var(--text-muted); line-height: 1.6; }
    .drive-link-cta-bar {
      display: inline-flex; align-items: center; justify-content: center; gap: 10px;
      width: 100%; padding: 13px 20px; border-radius: 8px; background: var(--crimson); color: #FFFFFF;
      font-size: 12.5px; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; transition: background 0.2s ease;
    }
    .drive-link-btn-card:hover .drive-link-cta-bar { background: #B81620; }

    /* ABOUT & EXPERIENCE */
    .about-exp-grid { display: grid; grid-template-columns: 0.95fr 1.25fr; gap: 44px; align-items: start; }
    .about-card { background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 30px; position: sticky; top: 94px; }
    .about-text { font-size: 14.5px; color: #D2D2DC; line-height: 1.75; white-space: pre-line; margin-bottom: 22px; }
    .about-meta-pill { display: inline-flex; align-items: center; gap: 8px; background: rgba(217, 30, 42, 0.12); border: 1px solid rgba(217, 30, 42, 0.3); padding: 8px 14px; border-radius: 8px; font-size: 12px; font-weight: 600; }
    .exp-timeline { display: flex; flex-direction: column; gap: 20px; }
    .exp-item { background: var(--bg-card); border: 1px solid var(--border-subtle); border-left: 3px solid var(--crimson); border-radius: var(--radius-md); padding: 22px 24px; transition: background 0.2s ease; }
    .exp-item:hover { background: var(--bg-card-hover); }
    .exp-top { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 8px; margin-bottom: 6px; }
    .exp-role { font-size: 16px; font-weight: 800; }
    .exp-period { font-size: 12px; font-weight: 700; color: var(--crimson); }
    .exp-company-row { display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 600; color: var(--text-muted); margin-bottom: 12px; }
    .exp-type-badge { background: rgba(255, 255, 255, 0.06); padding: 2px 8px; border-radius: 4px; font-size: 11px; color: var(--text-white); }
    .exp-desc { font-size: 13.5px; color: #C4C4CF; line-height: 1.65; white-space: pre-line; }

    /* EDUCATION, SKILLS, WORK PROCESS & QUOTE */
    .tri-editorial-grid { display: grid; grid-template-columns: 1.05fr 1.05fr 0.85fr; gap: 32px; align-items: stretch; }
    .edu-list { display: flex; flex-direction: column; gap: 16px; margin-bottom: 28px; }
    .edu-item { padding-bottom: 14px; border-bottom: 1px solid var(--border-subtle); }
    .edu-row-top { display: flex; justify-content: space-between; gap: 10px; margin-bottom: 3px; }
    .edu-title { font-size: 14px; font-weight: 700; }
    .edu-period { font-size: 11.5px; font-weight: 700; color: var(--crimson); white-space: nowrap; }
    .edu-inst { font-size: 12.5px; color: var(--text-muted); margin-bottom: 4px; }
    .edu-details { font-size: 12px; color: #A8A8B3; line-height: 1.5; }
    .skills-wrap { display: flex; flex-wrap: wrap; gap: 8px; }
    .skill-chip { background: var(--bg-card); border: 1px solid var(--border-strong); padding: 7px 12px; border-radius: 5px; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; transition: all 0.2s ease; }
    .skill-chip:hover { border-color: var(--crimson); background: rgba(217, 30, 42, 0.14); }

    .process-list { display: flex; flex-direction: column; gap: 18px; }
    .process-item { display: flex; align-items: flex-start; gap: 14px; }
    .process-num { font-family: var(--font-display); font-size: 20px; color: var(--crimson); min-width: 26px; padding-top: 4px; }
    .process-icon-box { width: 40px; height: 40px; border-radius: 50%; background: var(--bg-card); border: 1px solid var(--border-strong); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .process-title { font-size: 13.5px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: var(--crimson); margin-bottom: 3px; }
    .process-desc { font-size: 12.5px; color: var(--text-muted); line-height: 1.55; }

    .crimson-quote-card { background: linear-gradient(160deg, #B51621 0%, #52090E 100%); border-radius: var(--radius-lg); padding: 34px 28px; display: flex; flex-direction: column; justify-content: space-between; }
    .quote-mark { font-family: var(--font-display); font-size: 68px; line-height: 0.8; color: rgba(255, 255, 255, 0.35); margin-bottom: 14px; }
    .quote-body { font-size: 17px; font-weight: 600; line-height: 1.55; color: #FFFFFF; margin-bottom: 24px; }
    .quote-signature { font-family: var(--font-script); font-size: 36px; color: #FFFFFF; margin-bottom: 24px; }
    .quote-footer-note { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255, 255, 255, 0.85); border-top: 1px solid rgba(255, 255, 255, 0.22); padding-top: 14px; }

    /* CONTACT & FOOTER */
    .contact-section { padding: 76px 0 40px; }
    .contact-grid { display: grid; grid-template-columns: 0.95fr 1.15fr; gap: 40px; align-items: center; margin-bottom: 56px; }
    .contact-big-heading { font-family: var(--font-display); font-size: clamp(40px, 5vw, 62px); line-height: 1.02; text-transform: uppercase; margin-bottom: 16px; }
    .contact-subtext { font-size: 14px; color: var(--text-muted); max-width: 430px; margin-bottom: 26px; }
    .contact-cards-list { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .contact-row { display: flex; align-items: center; gap: 14px; background: var(--bg-card); border: 1px solid var(--border-subtle); padding: 16px; border-radius: var(--radius-md); transition: all 0.2s ease; cursor: pointer; }
    .contact-row:hover { border-color: var(--crimson); background: var(--bg-card-hover); transform: translateY(-2px); }
    .contact-icon-box { width: 42px; height: 42px; border-radius: 50%; background: rgba(217, 30, 42, 0.15); color: var(--crimson); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .contact-row-label { font-size: 10.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
    .contact-row-val { font-size: 13px; font-weight: 700; color: var(--text-white); }
    .footer-bottom { border-top: 1px solid var(--border-subtle); padding-top: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; font-size: 12px; color: var(--text-muted); }
    .secret-admin-trigger { cursor: default; user-select: none; }

    /* MODALS */
    .modal-backdrop { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.82); backdrop-filter: blur(6px); display: none; align-items: center; justify-content: center; padding: 20px; z-index: 9500; }
    .modal-backdrop.open { display: flex; }
    .modal-box { background: var(--bg-surface); border: 1px solid var(--border-strong); border-radius: var(--radius-lg); width: 100%; max-width: 720px; max-height: 90vh; overflow-y: auto; position: relative; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.75); }
    .modal-close-btn { position: absolute; top: 14px; right: 14px; width: 36px; height: 36px; border-radius: 50%; background: rgba(8, 8, 10, 0.8); border: 1px solid var(--border-strong); color: #FFFFFF; display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 2; }

    /* ADMIN PANEL */
    .admin-wrapper { display: none; min-height: 100vh; background: #09090C; }
    .admin-wrapper.active { display: block; }
    .public-wrapper.hidden { display: none; }
    .login-box-wrap { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }
    .login-card { background: var(--bg-surface); border: 1px solid var(--border-strong); border-top: 4px solid var(--crimson); border-radius: var(--radius-lg); padding: 36px 30px; width: 100%; max-width: 410px; }
    .admin-topbar { background: var(--bg-surface); border-bottom: 1px solid var(--border-strong); padding: 16px 0; position: sticky; top: 0; z-index: 800; }
    .admin-topbar-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
    .admin-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0; }
    .admin-tab-btn { background: var(--bg-card); border: 1px solid var(--border-subtle); color: var(--text-muted); padding: 10px 16px; border-radius: 8px; font-size: 12.5px; font-weight: 700; cursor: pointer; transition: all 0.2s ease; }
    .admin-tab-btn.active, .admin-tab-btn:hover { background: var(--crimson); border-color: var(--crimson); color: #FFFFFF; }
    .admin-panel-card { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 24px; margin-bottom: 24px; }
    .form-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .form-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
    .form-label { font-size: 12px; font-weight: 700; color: #D0D0DA; }
    .form-control { background: #0D0D11; border: 1px solid var(--border-strong); color: var(--text-white); padding: 10px 13px; border-radius: 8px; font-size: 13.5px; outline: none; transition: border-color 0.2s ease; }
    .form-control:focus { border-color: var(--crimson); }
    textarea.form-control { min-height: 92px; resize: vertical; }
    .img-preview-box { width: 120px; height: 120px; border-radius: 10px; border: 1px dashed var(--border-strong); background: #0D0D11; display: flex; align-items: center; justify-content: center; overflow: hidden; font-size: 11px; color: var(--text-muted); text-align: center; }
    .img-preview-box img { width: 100%; height: 100%; object-fit: cover; }
    .admin-list-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .admin-list-table th, .admin-list-table td { text-align: left; padding: 12px 10px; border-bottom: 1px solid var(--border-subtle); vertical-align: top; }
    .admin-list-table th { color: var(--text-muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; }

    @media (max-width: 980px) {
      .hero-grid { grid-template-columns: 1fr; padding-top: 56px; }
      .hero-center { order: -1; }
      .hero-portrait-frame { max-width: 340px; }
      .hero-metrics-stack { display: grid; grid-template-columns: repeat(3, 1fr); }
      .about-exp-grid, .tri-editorial-grid, .contact-grid { grid-template-columns: 1fr; }
      .about-card { position: static; }
    }
    @media (max-width: 680px) {
      .nav-links, .nav-status { display: none; }
      .mobile-menu-btn { display: flex; }
      .hero-metrics-stack, .drive-links-grid, .contact-cards-list, .form-grid-2, .form-grid-3 { grid-template-columns: 1fr; }
      .admin-list-table { font-size: 11.5px; }
    }
  </style>
</head>
<body>

  <div id="globalLoader" class="global-loader">
    <div class="spinner-ring"></div>
    <p style="margin-top:14px;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:#9E9EA8;">Memuat Portfolio...</p>
  </div>

